# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional compatibility name for older Supabase projects. The app prefers the
# publishable key above and falls back to this value.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only OpenAI key for GL-MVP-002 import extraction. Never prefix this
# variable with NEXT_PUBLIC_ and never commit a real key.
OPENAI_API_KEY=your-openai-api-key

# Optional. Defaults to gpt-5.6-terra.
# OPENAI_MODEL=gpt-5.6-terra
